# Starter-managed service sources. The first deploy clones and later deploys
# fast-forward these exact branches. Override only when testing another source.
AGENT_GIT_URL=git@github.com:ChouKevin/java-system-agent.git
AGENT_GIT_REF=uat
SEMANTIC_GIT_URL=git@github.com:ChouKevin/java-code-intelligence.git
SEMANTIC_GIT_REF=uat

# Generated automatically on first deploy. Set it yourself only when clients
# must keep an existing shared token.
SEMANTIC_API_TOKEN=

# Optional credentials used by Semantic Service when catalog repositories are private.
GIT_USERNAME=
GIT_TOKEN=

# Optional runtime overrides.
SEMANTIC_HOST_PORT=8080
JDTLS_MAX_ACTIVE_WORKSPACES=2
JDTLS_REQUEST_TIMEOUT=120s
REPOSITORY_SYNTAX_CACHE_MAXIMUM_WEIGHT=120000
REPOSITORY_SYNTAX_CACHE_MAXIMUM_ENTRY_WEIGHT=60000
POSTGRES_USER=agent
POSTGRES_DB=java_system_agent
POSTGRES_PASSWORD=poc-postgres-password
SPRING_PROFILES_ACTIVE=agent-runtime

# Required only for Slack admission or model calls.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-3.1-flash-lite
